# ====================================================
# KONFIGURASI SUPABASE (SMK WIHDATUL UMMAH)
# ====================================================
# Dapatkan data ini di dashboard Supabase:
# Masuk ke Project Settings -> API
# 
# Jika SUPABASE_URL dikosongkan, server otomatis 
# menggunakan penyimpanan lokal (data/db.json).

SUPABASE_URL=
SUPABASE_KEY=

# Port Server Web (Default: 3000)
PORT=3000
